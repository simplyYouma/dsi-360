# Dépendances
node_modules/
.venv/
__pycache__/
*.pyc
*.egg-info/

# Build
dist/
build/
# Builds de préparation et de repli : la mise en ligne compile à côté (`dist-maj`) pendant que
# l'API sert encore `dist`, puis échange les deux en conservant l'ancien (`dist-old-<horodatage>`).
# Sans cette ligne, chacun de ces répertoires apparaît en « fichier non suivi » et fait échouer
# l'avant-vol de METTRE-A-JOUR-DSI360.bat — qui propose alors un `git clean -fd`.
dist-*/
# Cache incrémental de tsc : change à chaque compilation, ne dit rien du code
*.tsbuildinfo

# Caches d'outils (régénérés à chaque exécution — jamais versionnés)
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets / env (jamais commités)
infra/env/.env
*.env
!*.env.example
# Script de provisionnement DB natif : contient le mot de passe applicatif.
# Motif SANS chemin, volontairement : ce fichier ne doit jamais être commité, où qu'il se trouve.
# La règle visait auparavant un chemin précis ; le jour où le dossier a été réorganisé, l'exemplaire
# resté en place sur le serveur a cessé d'être ignoré — et la mise à jour a refusé de démarrer sur
# « modifications locales », en proposant un `git clean` qui l'aurait effacé avec son mot de passe.
provisionner-db.sql

# Données / uploads locaux
/data/

# OS / IDE
.DS_Store
Thumbs.db
.idea/

# Certificats / cles TLS (vivent seulement sur le serveur — jamais versionnes)
cert/
*.pem
*.key
*.pfx
*.crt
# Sauvegardes de base (pg_dump)
*.dump

# Sources de conception confidentielles (banque) — jamais publiees
docs/_sources-conception/
infra/nginx/certs/

# Supports de présentation / marketing : ne jamais pousser (peuvent contenir des captures internes).
docs/*.pdf
*Présentation produit*

# Journaux des scripts d exploitation (start-dev, maj-prod) : locaux a chaque poste.
infra/local/logs/
